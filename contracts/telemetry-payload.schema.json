{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AstronautTelemetryPayload",
  "description": "Contrato de telemetría biomédica, nutricional y ambiental para el proyecto Synera - Galley (Web Serial, BLE o Simulador)",
  "type": "object",
  "properties": {
    "astronaut_id": {
      "type": "string",
      "description": "Identificador único del astronauta (ej. ASTRO-001)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Marca de tiempo ISO 8601 (UTC)"
    },
    "capture_source": {
      "type": "string",
      "enum": ["web_serial_usb", "wearable_ble", "manual_entry", "simulator"],
      "description": "Origen de los datos capturados"
    },
    "environment": {
      "type": "string",
      "enum": ["ISS", "DeepSpaceTransit", "LunarBase", "MarsMission"],
      "default": "ISS",
      "description": "Entorno operacional actual (ISS vs. Marte)"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "heart_rate": {
          "type": "object",
          "properties": {
            "bpm": { "type": "number", "minimum": 25, "maximum": 240, "description": "Frecuencia cardíaca en lpm" },
            "spo2": { "type": "number", "minimum": 60, "maximum": 100, "description": "Saturación de oxígeno %" },
            "hrv_rmssd": { "type": "number", "minimum": 0, "maximum": 300, "description": "Variabilidad de la frecuencia cardíaca en ms" }
          },
          "required": ["bpm"]
        },
        "blood_pressure": {
          "type": "object",
          "properties": {
            "systolic": { "type": "number", "minimum": 50, "maximum": 260 },
            "diastolic": { "type": "number", "minimum": 30, "maximum": 160 }
          }
        },
        "body_temperature": {
          "type": "object",
          "properties": {
            "celsius": { "type": "number", "minimum": 30.0, "maximum": 44.0, "description": "Temperatura corporal cutánea/núcleo en °C" }
          },
          "required": ["celsius"]
        },
        "sleep": {
          "type": "object",
          "properties": {
            "duration_hours": { "type": "number", "minimum": 0, "maximum": 24, "description": "Horas de sueño acumuladas" },
            "quality_score": { "type": "integer", "minimum": 1, "maximum": 10 }
          },
          "required": ["duration_hours"]
        },
        "mood": {
          "type": "object",
          "properties": {
            "score": { "type": "integer", "minimum": 1, "maximum": 10, "description": "Puntaje de ánimo y alerta subjetiva (1 a 10)" },
            "pvt_reaction_time_ms": { "type": "number" }
          },
          "required": ["score"]
        },
        "nutrition": {
          "type": "object",
          "properties": {
            "meal_intake_percentage": { "type": "number", "minimum": 0, "maximum": 100, "description": "Porcentaje de porciones de menú consumidas según plan calórico" },
            "hydration_liters": { "type": "number", "minimum": 0, "maximum": 10 }
          }
        },
        "exercise": {
          "type": "object",
          "properties": {
            "duration_minutes": { "type": "number", "minimum": 0, "maximum": 360, "description": "Minutos de contramedida física en ARED/Cicloergómetro" },
            "intensity": { "type": "string", "enum": ["REST", "LIGHT", "MODERATE", "VIGOROUS"] }
          }
        },
        "radiation": {
          "type": "object",
          "properties": {
            "dose_rate_uSv_h": { "type": "number", "minimum": 0 },
            "cumulative_dose_mSv": { "type": "number", "minimum": 0 }
          }
        }
      },
      "required": ["heart_rate", "body_temperature", "sleep", "mood"]
    }
  },
  "required": ["astronaut_id", "timestamp", "capture_source", "metrics"]
}
