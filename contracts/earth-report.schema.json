{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EarthReportSBARSchema",
  "description": "Reporte clínico aeroespacial en formato estándar S-B-A-R (Situation, Background, Assessment, Recommendation) para el Cirujano de Vuelo y Control de Misión",
  "type": "object",
  "properties": {
    "report_id": { "type": "string" },
    "astronaut_id": { "type": "string" },
    "mission_day": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "environment": { "type": "string", "enum": ["ISS", "DeepSpaceTransit", "LunarBase", "MarsMission"] },
    "escalation_level": { "type": "integer", "enum": [1, 2, 3, 4] },
    "sbar": {
      "type": "object",
      "properties": {
        "situation": {
          "type": "string",
          "description": "S: Qué está ocurriendo en este momento con el astronauta y motivo del reporte"
        },
        "background": {
          "type": "string",
          "description": "B: Contexto clínico, línea base personal individual y tendencias de los últimos días"
        },
        "assessment": {
          "type": "object",
          "properties": {
            "traffic_light_summary": {
              "type": "object",
              "additionalProperties": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] }
            },
            "active_alerts": {
              "type": "array",
              "items": { "type": "string" }
            },
            "clinical_inference": {
              "type": "string",
              "description": "Inferencia determinista de causa fisiológica (fatiga, infección, desacondicionamiento)"
            }
          },
          "required": ["traffic_light_summary", "clinical_inference"]
        },
        "recommendation": {
          "type": "object",
          "properties": {
            "immediate_crew_actions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "flight_surgeon_consult_request": { "type": "string" },
            "contingency_protocol": { "type": "string" }
          },
          "required": ["immediate_crew_actions"]
        }
      },
      "required": ["situation", "background", "assessment", "recommendation"]
    }
  },
  "required": ["report_id", "astronaut_id", "mission_day", "generated_at", "environment", "escalation_level", "sbar"]
}
