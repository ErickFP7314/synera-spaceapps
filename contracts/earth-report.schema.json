{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EarthReportSchema",
  "description": "Formato de resumen de salud de 1 página ('Parte para Tierra') optimizado para transmisión asíncrona con ancho de banda limitado (Store-and-Forward)",
  "type": "object",
  "properties": {
    "report_id": { "type": "string" },
    "astronaut_id": { "type": "string" },
    "mission_day": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "escalation_level": {
      "type": "integer",
      "enum": [1, 2, 3, 4],
      "description": "Nivel de escalamiento actual: 1=Autocuidado, 2=Aviso tripulación, 3=Consulta médica de vuelo, 4=Urgencia médica"
    },
    "traffic_light_summary": {
      "type": "object",
      "properties": {
        "heart_rate": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] },
        "blood_pressure": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] },
        "body_temperature": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] },
        "glucose": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] },
        "sleep": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] },
        "mood": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] },
        "radiation": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] }
      },
      "required": ["heart_rate", "blood_pressure", "body_temperature", "glucose", "sleep", "mood"]
    },
    "active_alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["COMBINATION", "TREND", "THRESHOLD", "BASELINE_DEVIATION"] },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "message": { "type": "string" },
          "trigger_factors": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "type", "severity", "message"]
      }
    },
    "baseline_deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": { "type": "string" },
          "current_value": { "type": "number" },
          "baseline_mean": { "type": "number" },
          "z_score": { "type": "number" },
          "trend_direction": { "type": "string", "enum": ["IMPROVING", "STABLE", "DEGRADING"] }
        },
        "required": ["metric", "current_value", "baseline_mean", "z_score"]
      }
    },
    "actionable_recommendations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "explanation_statement": {
      "type": "string",
      "description": "Texto determinista justificando el nivel de escalamiento y diagnóstico preliminar sin caja negra"
    }
  },
  "required": [
    "report_id",
    "astronaut_id",
    "mission_day",
    "generated_at",
    "escalation_level",
    "traffic_light_summary",
    "active_alerts",
    "explanation_statement"
  ]
}
